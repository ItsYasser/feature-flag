# Postgres connection string. On Vercel the Neon Marketplace integration sets this for you.
# Use the pooled Neon URL, e.g.:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Leave unset (or use pglite://./.data/pglite) to run against an embedded Postgres with no setup.
# pglite://memory gives a throwaway in-memory database.
DATABASE_URL=
